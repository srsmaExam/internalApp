# ==============================================================================
# VIDYA TEST PREP / SRSMA JEE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# Configured in your Cloudflare Dashboard (Workers & Pages > Settings > Variables)
# or in `.env.production` / `.dev.vars` for local preview.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required in Production — Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for your managed Supabase PostgreSQL instance.
#
# Examples:
#   Supabase (Transaction Pooler - Port 6543, REQUIRED for Cloudflare / Serverless):
#     DATABASE_URL=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Supabase (Session Pooler - Port 5432):
#     DATABASE_URL=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# SUPERCHARGED OPTION: Cloudflare Hyperdrive
#   If you create a Hyperdrive binding named `HYPERDRIVE` or `DATABASE` in Cloudflare,
#   the app automatically detects and routes queries through Hyperdrive's global edge pool!
#
# NOTE ON SPECIAL CHARACTERS IN PASSWORD:
# If your password has special characters like '@', '!', '#', they MUST be URL-encoded!
# E.g., '@' -> '%40', '!' -> '%21' (e.g., 'SRSMA@108!!' becomes 'SRSMA%40108%21%21').
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Maximum connection pool size (defaults to 5 on Cloudflare edge)
DATABASE_POOL_MAX=5

# Set to 'false' only if your database does not support SSL (e.g., plain local docker)
# DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. SESSION & COOKIE SECURITY (Required in Production)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify student/teacher session tokens (HMAC-SHA256).
# MUST be set explicitly in production to a persistent random string (at least 32 chars).
# Generate one using: openssl rand -base64 32  or  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-very-long-and-cryptographically-secure-random-string-at-least-32-chars

# Enforce secure HTTPS-only cookies in production (recommended true for HTTPS sites)
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 3. EXAM TIMER & SWEEP CRON JOB (Recommended in Production)
# ------------------------------------------------------------------------------
# Secret key required to trigger the background auto-submit sweep endpoint
# (/api/cron/sweep-expired). Protects against unauthorized callers.
# Generate any random string (e.g. openssl rand -hex 16).
CRON_SECRET=replace-with-a-random-cron-secret-token

# Set to 'true' in serverless environments (like Vercel) to disable the in-process setInterval timer
# and rely exclusively on external cron triggers (/api/cron/sweep-expired).
# DISABLE_SWEEP_TIMER=true

# ------------------------------------------------------------------------------
# 4. STORAGE & DIRECTORIES (Optional)
# ------------------------------------------------------------------------------
# Root directory where uploaded source PDFs and cropped question diagrams live.
# On a VPS or container with attached volume, point this to your mounted volume (e.g. /data or /mnt/volume).
# Defaults to ./data if omitted.
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 5. OPTIONAL PUBLIC APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://study.srsma.in

# ------------------------------------------------------------------------------
# 6. WHATSAPP CLOUD API CONFIGURATION (Meta for Developers)
# ------------------------------------------------------------------------------
# 15-digit Phone Number ID from WhatsApp > API Setup in Meta Developer Dashboard
WHATSAPP_PHONE_NUMBER_ID=102938475610293

# Permanent System User Access Token from Meta Business Settings > System Users
WHATSAPP_ACCESS_TOKEN=EAAG...

# Name of your approved WhatsApp Authentication template in WhatsApp Manager
WHATSAPP_TEMPLATE_NAME=student_login_otp

# Language code used when submitting the template (e.g., en_US)
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Set to 'true' only if you want to bypass sending real WhatsApp messages and print OTPs to server console
# ENABLE_DEV_OTP_MOCK=false

# ------------------------------------------------------------------------------
# 7. GOOGLE ANALYTICS 4 (Optional in dev, Recommended in Production)
# ------------------------------------------------------------------------------
# Your GA4 Measurement ID from Google Analytics > Admin > Data Streams > Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-D36DLF1HJX


